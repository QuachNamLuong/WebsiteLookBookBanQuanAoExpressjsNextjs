generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id Int @id @default(autoincrement())
  username String @unique
  email String @unique
  passwordHash String @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  roles Role[]
  createGoodsReceipts GoodsReceipt[] @relation(name: "createGoodsReceiptBy")
  updateGoodsReceipts GoodsReceipt[] @relation(name: "updateGoodsReceiptBy")
}

enum RoleName {
  USER
  ADMIN
}

model Role {
  id Int @id @default(autoincrement())
  name RoleName @unique
  description String?
  createdAt DateTime @default(now())

  users User[]
  permissions Permission[]
}

model Permission {
  id Int @id @default(autoincrement())
  name String
  description String?
  createdAt DateTime @default(now())

  roles Role[]
}

model ProductCategory {
  id Int @id @default(autoincrement())
  name String @unique
  slug String @unique
  
  products Product[]
}

model Product {
  id Int @id @default(autoincrement())
  code String @unique
  name String @unique

  productCategoryId Int?
  productCategory ProductCategory? @relation(fields: [productCategoryId], references: [id])
  price Decimal
  style String?
  nameMean String?
  usage String?
  material String?
  color String?
  stock Int

  variants ProductVariant[]
  productImage ProductImage[]

  productEvents ProductEvent[]
}

model ProductImage {
  id Int @id @default(autoincrement())
  alt String?
  href String

  productId Int 
  product Product @relation(fields: [productId], references: [id])
}

enum Size {
  XS
  S
  M
  L
  XL
  XXL
}

model ProductVariant {
  id Int @id @default(autoincrement())
  size Size?
  stock Int @default(0)

  productId Int
  product Product @relation(fields: [productId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orderItems OrderItem[]
  cartItems CartItem[]
}

model GoodsReceipt {
  id Int @id @default(autoincrement())
  code String @unique
  quantity Int

  createdByUserId Int 
  createdByUser User @relation(name: "createGoodsReceiptBy", fields: [createdByUserId], references: [id])

  updatedByUserId Int?
  updatedByUser User? @relation(name: "updateGoodsReceiptBy", fields: [updatedByUserId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Order {
  id Int @id @default(autoincrement())
  code String @unique

  totalPrice BigInt
}

model OrderItem {
  id Int @id @default(autoincrement())

  productVariantId Int
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
}

model Cart {
  id Int @id @default(autoincrement())

  cartItems CartItem[]
}

model CartItem {
  id Int @id @default(autoincrement())

  productVariantId Int
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])
  cartId Int
  cart Cart @relation(fields: [cartId], references: [id])
}

model ProductEvent {
  id           BigInt   @id @default(autoincrement())

  clickCount   Int      @default(0)
  addToCartCount Int    @default(0)
  orderCount   Int      @default(0)
  day          DateTime @default(now())

  productId    Int
  product      Product  @relation(fields: [productId], references: [id])

  @@unique([productId, day])
  @@index([day])
}